{
  "name": "nc-baseball-alert",
  "version": "1.0.0",
  "description": "NC 다이노스 경기 알림 PWA (Cloudflare Workers + Web Push)",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "genkeys": "node scripts/genkeys.mjs",
    "genicons": "python scripts/genicons.py",
    "gentossface": "python scripts/gentossface.py",
    "build:check": "wrangler deploy --dry-run",
    "test": "node scripts/selftest.mjs",
    "db:init": "wrangler d1 execute nc-alert --remote --file=./schema.sql",
    "db:init:local": "wrangler d1 execute nc-alert --local --file=./schema.sql",
    "tail": "wrangler tail"
  },
  "devDependencies": {
    "wrangler": "^4.126.0"
  },
  "dependencies": {
    "es-hangul": "^2.4.0"
  }
}
